# Copy this file to backend/.env and fill in the values. Never commit .env.

# Supabase -> Connect -> Session pooler URI.
# Change the "postgresql://" prefix to "postgresql+psycopg://" and insert your DB password.
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Google AI Studio -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback used when Gemini is rate-limited or unavailable (console.groq.com -> API Keys).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Order in which providers are tried; providers without a key are skipped.
LLM_PROVIDERS=gemini,groq

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173
